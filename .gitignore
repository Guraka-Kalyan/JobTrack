# OS & IDE metadata
.DS_Store
Thumbs.db
*.swp
*.bak
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# Build artifacts & packages
**/target/
**/dist/
**/build/
**/node_modules/
*.log

# Environment variables & local configuration secrets
**/.env
**/.env.local
**/.env.*.local
!**/.env.example
application-local.properties

# Logs & scratch
logs/
scratch/
*.tmp
